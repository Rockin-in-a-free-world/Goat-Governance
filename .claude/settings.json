{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "ask": [
      "Bash",
      "PowerShell",
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Edit(./registry/**)",
      "Edit(./rules/**)",
      "Edit(./scripts/**)",
      "Edit(./skills/approved/**)",
      "Edit(./memory/approved/**)",
      "Edit(./mcp/approved/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/enforce_claude_policy.py"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}

