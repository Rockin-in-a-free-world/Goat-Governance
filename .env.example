# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Reviewer identity passed to scripts/promote_*.py and scripts/reseal_approved.py
# as --approved-by (for example: --approved-by "$GOVERNANCE_APPROVER").
GOVERNANCE_APPROVER=the-goat

# Local directory holding the product walkthrough videos and reference SRTs used by
# skills/candidates/screen-walkthrough-video.
VIDEOS_DIR=/path/to/videos

# Clone locations, so memory commands work from any directory (see docs/share-memory.md).
GOAT_GOVERNANCE=/path/to/goat-governance
GOAT_MEMORY=/path/to/goat-memory
